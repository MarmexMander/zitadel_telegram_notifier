# Match compose/apps/zitadel_notify/zitadel_notify.env.j2
BOT_TOKEN=
BOT_MODE=webhook
PUBLIC_BASE_URL=https://notifier.zitadel.ascend.example.com
WEBHOOK_SECRET=
MASTER_KEY=replace-with-url-safe-base64-32-byte-key
ADMIN_IDS=
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
LOG_LEVEL=INFO
LOG_FORMAT=json

PG_HOST=postgres
PG_PORT=5432
PG_USER=zitadel_notify
PG_PASSWORD=change-me
PG_DATABASE=zitadel_notify
PG_SSLMODE=disable

# Optional overrides
# DATABASE_URL=postgresql+asyncpg://zitadel_notify:change-me@postgres:5432/zitadel_notify
OUTBOX_TTL_HOURS=72
SIGNING_KEY_OVERLAP_SECONDS=300
SKIP_TELEGRAM_WEBHOOK_REGISTER=false

# Runtime + CLI: Zitadel API for invite-on-nickname Action
ZITADEL_BASE_URL=https://zitadel.ascend.example.com
# Preferred: machine-user private-key file (compose mounts this) → short-lived access token
ZITADEL_MACHINE_KEY_FILE=/run/secrets/zitadel_machine_key.json
# Or JSON in env / already-minted bearer for local CLI:
# ZITADEL_MACHINE_KEY_JSON={"type":"serviceaccount","keyId":"...","key":"-----BEGIN...","userId":"..."}
# ZITADEL_ACCESS_TOKEN=
# ZITADEL_PAT=
ZITADEL_PROVIDER_ENDPOINT=http://172.30.50.2:8080/zitadel/hook
ZITADEL_PROVIDER_DESCRIPTION=Telegram notifier
ZITADEL_PROVIDER_ID=
ZITADEL_ACTION_ENDPOINT=http://172.30.50.2:8080/zitadel/action/invite
ZITADEL_ACTION_NAME=telegram-invite-on-nickname
